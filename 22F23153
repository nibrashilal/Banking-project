# Student Performance Analysis Algorithm

students_scores = [85, 72, 40, 90, 60]
total_score = 0
passed_students = 0
total_students = 0 

for score in students_scores:
    total_students += 1
    total_score += score
    
    if score >= 50:
        passed_students += 1
    else:
        print("Student needs academic support")

average_score = total_score / len(students_scores)

if average_score >= 75:
    print("Overall performance is Excellent")
else:
    print("Overall performance needs improvement")
